{
  "name": "@paperclipai/sdk",
  "version": "0.3.1",
  "description": "Typed client for the Automatic Organisation REST API",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/cjs/index.d.ts",
          "default": "./dist/cjs/index.js"
        }
      },
      "./openapi.json": "./openapi.json"
    },
    "main": "./dist/cjs/index.js",
    "types": "./dist/index.d.ts",
    "module": "./dist/index.js"
  },
  "files": [
    "dist",
    "openapi.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node ../../cli/node_modules/tsx/dist/cli.mjs ../../server/scripts/export-openapi.ts ./openapi.json && openapi-typescript ./openapi.json -o ./src/schema.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'}))\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "openapi-typescript": "7.4.4",
    "typescript": "5.6.3"
  }
}
