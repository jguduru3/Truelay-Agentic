# Copy to truelay/deploy/.env on the Azure VM, fill in, then: chmod 600 truelay/deploy/.env
# Never commit the real .env.

# The HTTPS address people and webhooks use. Must match the Caddyfile host.
PAPERCLIP_PUBLIC_URL=https://eggbreak.truelay.in

# Azure Database for PostgreSQL Flexible Server. Private access (same virtual network as the VM).
# Format: postgres://<admin-user>:<url-encoded-password>@<server-name>.postgres.database.azure.com:5432/paperclip?sslmode=require
DATABASE_URL=

# Generate each of these on the VM with: openssl rand -base64 48
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Set to true after the founder and deputy have created their accounts.
PAPERCLIP_AUTH_DISABLE_SIGN_UP=false

# Anthropic API key used by all 11 agents unless an agent has its own.
# Set an organisation monthly spend cap in the Anthropic Console as well.
ANTHROPIC_API_KEY=

# Used by backup.sh (no keys needed: the VM's managed identity has
# "Storage Blob Data Contributor" on the storage account).
AZURE_STORAGE_ACCOUNT=truelayeggbreak
AZURE_BACKUP_CONTAINER=backups
