# /etc/caddy/Caddyfile on the Truelay EggBreak server.
# Caddy gets and renews the HTTPS certificate automatically once DNS points here.

eggbreak.truelay.in {
	encode zstd gzip
	reverse_proxy 127.0.0.1:3100
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
